# ─────────────────────────────────────────────────────────────────────────────
# STC Cloud — Variables de entorno de PRODUCCIÓN (self-hosted, Docker)
# ─────────────────────────────────────────────────────────────────────────────
# Instrucciones:
#   1. Copiar este archivo a .env.production
#   2. Completar TODOS los valores marcados con CAMBIAR_*, y DOMAIN (deploy.sh
#      lo exige y lo usa para nginx.conf + el certificado SSL de certbot)
#   3. NUNCA commitear .env.production con valores reales al repositorio
# ─────────────────────────────────────────────────────────────────────────────

# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Dominio propio (usado por deploy.sh para nginx.conf y el certificado SSL) ─
DOMAIN=stc-cloud.tu-dominio.com

# ─── Base de datos (Postgres/TimescaleDB self-hosted, contenedor `postgres`
#     del mismo docker-compose.prod.yml — ya no se usa Neon/Render/Railway) ────
DB_HOST=postgres
DB_PORT=5432
DB_USER=stc_admin
DB_PASSWORD=CAMBIAR_POR_CONTRASENA_BD_SEGURA
DB_NAME=stc_cloud
# Pool de Knex — default razonable para varios clientes syncando en paralelo;
# subir sólo si ves timeouts de conexión bajo carga real, y no superar el
# max_connections de Postgres si en el futuro corren varias réplicas de `api`.
# DB_POOL_MIN=2
# DB_POOL_MAX=20

# ─── Redis (contenedor `redis` del mismo docker-compose.prod.yml) ────────────
REDIS_URL=redis://redis:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_LARGO_Y_SEGURO

# ─── Cookie ──────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
COOKIE_SECRET=CAMBIAR_POR_STRING_ALEATORIO_SEGURO

# ─── Portal Admin ────────────────────────────────────────────────────────────
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA

# ─── CORS — Origen del portal (mismo dominio propio, portal y API detrás del
#     mismo nginx) ────────────────────────────────────────────────────────────
PORTAL_ORIGIN=https://stc-cloud.tu-dominio.com

# ─── Alertas de toner ───────────────────────────────────────────────────────
TONER_WARN_PCT=20
TONER_CRITICAL_PCT=10

# ─── SMTP — Notificaciones por email (opcional) ─────────────────────────────
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@tu-empresa.com
# SMTP_PASSWORD=CAMBIAR_POR_CONTRASENA_SMTP
# SMTP_FROM="STC Cloud <notificaciones@tu-empresa.com>"
# ALERT_EMAIL_TO=admin@tu-empresa.com

# Techo del rate-limit por IP por minuto (default 100 si no se define).
# Subirlo solo en entornos de desarrollo/test donde una sola IP concentra
# todo el tráfico (la suite e2e completa supera 100 req/min).
# RATE_LIMIT_MAX=100
