# ─────────────────────────────────────────────────────────────────────────────
# STC Cloud — Variables de entorno de PRODUCCIÓN (self-hosted, Docker)
# ─────────────────────────────────────────────────────────────────────────────
# Instrucciones:
#   1. Copiar este archivo a .env.production
#   2. Completar TODOS los valores marcados con CAMBIAR_*, y DOMAIN (deploy.sh
#      lo exige y lo usa para nginx.conf + el certificado SSL de certbot)
#   3. NUNCA commitear .env.production con valores reales al repositorio
# ─────────────────────────────────────────────────────────────────────────────

# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Dominio propio (usado por deploy.sh para nginx.conf y el certificado SSL) ─
DOMAIN=stc-cloud.tu-dominio.com

# ─── Base de datos (Postgres/TimescaleDB self-hosted, contenedor `postgres`
#     del mismo docker-compose.prod.yml — ya no se usa Neon/Render/Railway) ────
DB_HOST=postgres
DB_PORT=5432
DB_USER=stc_admin
DB_PASSWORD=CAMBIAR_POR_CONTRASENA_BD_SEGURA
DB_NAME=stc_cloud
# Pool de Knex — default razonable para varios clientes syncando en paralelo;
# subir sólo si ves timeouts de conexión bajo carga real, y no superar el
# max_connections de Postgres si en el futuro corren varias réplicas de `api`.
# DB_POOL_MIN=2
# DB_POOL_MAX=20

# ─── Réplicas de `api` (Fase 16 producción-readiness, 26/08/2026) ───────────
# Cuántos contenedores de `api` levanta `docker-compose.prod.yml`. Default 1
# (sin esta variable, cero cambio de comportamiento). Seguro para subir desde
# la Fase 15 (relay Redis del proxy EWS) + la Fase 5 (advisory locks/pub-sub
# de WS) — nginx reparte entre réplicas vía DNS embebido de Docker (no es
# round-robin estricto por request: cada ~10s, TTL del `resolver`, elige la
# siguiente réplica y sostiene esa elección hasta la próxima resolución).
# Antes de subirla, multiplicar DB_POOL_MAX de arriba × esta variable y
# confirmar que no supera max_connections de Postgres.
# API_REPLICAS=2

# ─── Redis (contenedor `redis` del mismo docker-compose.prod.yml) ────────────
REDIS_URL=redis://redis:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_LARGO_Y_SEGURO

# ─── Cookie ──────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
COOKIE_SECRET=CAMBIAR_POR_STRING_ALEATORIO_SEGURO

# ─── Portal Admin ────────────────────────────────────────────────────────────
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA

# ─── CORS — Origen del portal (mismo dominio propio, portal y API detrás del
#     mismo nginx) ────────────────────────────────────────────────────────────
PORTAL_ORIGIN=https://stc-cloud.tu-dominio.com

# ─── Alertas de toner ───────────────────────────────────────────────────────
TONER_WARN_PCT=20
TONER_CRITICAL_PCT=10

# ─── SMTP — Notificaciones por email (opcional) ─────────────────────────────
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@tu-empresa.com
# SMTP_PASSWORD=CAMBIAR_POR_CONTRASENA_SMTP
# SMTP_FROM="STC Cloud <notificaciones@tu-empresa.com>"
# ALERT_EMAIL_TO=admin@tu-empresa.com

# Techo del rate-limit GENERAL por IP por minuto (default 100 si no se define).
# Subirlo solo en entornos de desarrollo/test donde una sola IP concentra
# todo el tráfico (la suite e2e completa supera 100 req/min).
# RATE_LIMIT_MAX=100

# /portal/login y /agents/activate tienen SU PROPIO techo antibruteforce,
# independiente del de arriba (defaults seguros: 10/min y 5/min). Subirlos
# SOLO en desarrollo/test: la suite e2e completa loguea/activa agentes desde
# una sola IP muchas más veces por minuto que eso.
# LOGIN_RATE_LIMIT_MAX=10
# AGENT_ACTIVATE_RATE_LIMIT_MAX=5

# ─── Observabilidad (Fase 5 producción-readiness) ────────────────────────────
# Sentry: definir el DSN activa la captura de errores (sin definir = no-op).
# SENTRY_DSN=

# /metrics (Prometheus): si se define, el endpoint exige
# `Authorization: Bearer <token>`. Sin definir queda abierto — aceptable solo
# porque en el compose de producción la API no publica puerto fuera de la red
# interna (nginx no proxea /metrics).
# METRICS_TOKEN=

# ─── Dashboards Grafana + alerting (Fase 17, 26/08/2026) ─────────────────────
# Sólo aplica si se levanta con el perfil opcional `observability`:
#   docker compose -f docker-compose.prod.yml --env-file .env.production \
#     --profile observability up -d
# Grafana queda expuesto en https://$DOMAIN/grafana/ (mismo TLS/dominio que
# portal y API, ver nginx.conf) — CAMBIAR la contraseña, mismo criterio que
# PORTAL_ADMIN_PASSWORD/DB_PASSWORD de arriba.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA
# Prometheus/Alertmanager NO se exponen (ni puerto ni nginx) — se acceden
# sólo dentro de la red de Docker (`docker compose exec prometheus sh`, o un
# túnel SSH si hace falta la UI). Las alertas de `prometheus/alerts.yml`
# llegan a Alertmanager pero no se envían a ningún lado hasta que se edite
# `alertmanager/alertmanager.yml` a mano con SMTP real (mismo SMTP_* de
# arriba) — se commitea con placeholders `CAMBIAR_*`, no lee variables de
# entorno (Alertmanager no soporta interpolación de env vars en su YAML).

# ─── Cifrado de credenciales de terceros (SNMPv3 + destino SFTP, Fase 19) ────
# Clave raíz para cifrar at-rest lo que un cliente carga desde el portal:
# credenciales SNMPv3 por agente y, desde la Fase 19, el destino SFTP de
# entrega de reportes por cliente. El nombre quedó del primer uso (SNMPv3,
# ver `services/cryptoService.ts`) — generalizado después vía HKDF con un
# `purpose` distinto por tipo de credencial, mismo valor de esta variable
# para ambos, subclaves derivadas independientes (comprometer una no
# compromete la otra). Sin esto seteada: SNMPv3 y SFTP simplemente no se
# pueden CONFIGURAR (nunca rompe el boot ni el resto de la app — la mayoría
# de las instalaciones no usa ninguna de las dos).
# Generar con: openssl rand -base64 32
# SNMP_CREDENTIALS_KEY=
