{
  "name": "stc-cloud-monorepo",
  "version": "1.0.0",
  "description": "Multi-brand Cloud Counter Reading System",
  "private": true,
  "workspaces": [
    "cloud",
    "agent",
    "shared"
  ],
  "scripts": {
    "dev:cloud": "npm run dev -w cloud",
    "dev:portal": "cd cloud/portal && npm run dev",
    "build:cloud": "npm run build -w cloud",
    "build:portal": "cd cloud/portal && npm install && npm run build",
    "build:agent": "npm run build -w agent && node agent/build-sea.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "snmp",
    "printer",
    "monitoring",
    "timescaledb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ws": "^8.17.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
